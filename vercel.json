{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!_expo|assets|favicon\\.ico|manifest\\.json|sw\\.js|icon\\.png).*)",
      "destination": "/"
    }
  ]
}
